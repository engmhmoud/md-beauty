{
  "manifest_version": 3,
  "name": "md-beauty",
  "version": "0.0.0",
  "description": "Read and edit markdown in a clean style: open folders and files, and .md files you open in the browser show the same way.",
  "homepage_url": "https://github.com/engmhmoud/md-beauty",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open md-beauty",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["file:///*.md", "file:///*.markdown", "*://*/*.md", "*://*/*.md?*", "*://*/*.markdown", "*://*/*.markdown?*"],
    "js": ["view.js"],
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{ "resources": ["index.html"], "matches": ["<all_urls>"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'" }
}
